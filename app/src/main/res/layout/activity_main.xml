<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- ================= MAIN CONTENT ================= -->
    <FrameLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ts_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- APP HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ts_primary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <!-- Hamburger menu button -->
                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Menu"
                    android:focusable="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_menu" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Training Sheet"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Training days, sets, reps and weights"
                        android:textColor="#BDBDBD"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- TRAINING DAYS BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ts_surface"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <!-- Day chips (item_day_chip) are added here from code -->
                    <LinearLayout
                        android:id="@+id/llDaysContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tvAddDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="+ Day"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SELECTED DAY HEADER (visible after a day is selected) -->
            <LinearLayout
                android:id="@+id/llDayHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDayName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ts_text"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Day name" />

                    <TextView
                        android:id="@+id/tvExerciseCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Exercises: 0"
                        android:textColor="@color/ts_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRenameDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_button_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="Rename"
                    android:textColor="@color/ts_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDeleteDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_button_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="Delete day"
                    android:textColor="@color/ts_danger"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- MAIN AREA -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- STATE: NO TRAINING DAYS (visible on start) -->
                <LinearLayout
                    android:id="@+id/llEmptyNoDays"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No training days yet"
                        android:textColor="@color/ts_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Create your first day, e.g. Push, Pull or Day 1, then start adding exercises to it."
                        android:textColor="@color/ts_text_secondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnCreateFirstDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_button_primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:paddingStart="28dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="28dp"
                        android:paddingBottom="14dp"
                        android:text="Create first day"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- DAY CONTENT (visible after a day is selected) -->
                <ScrollView
                    android:id="@+id/svContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="100dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- ADD / EDIT EXERCISE FORM (shown with the + button) -->
                        <LinearLayout
                            android:id="@+id/cardAddExercise"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:id="@+id/tvFormTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="New exercise"
                                android:textColor="@color/ts_primary"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etExerciseName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_input"
                                android:hint="Exercise name"
                                android:inputType="textCapSentences"
                                android:padding="12dp"
                                android:textColor="@color/ts_text"
                                android:textColorHint="@color/ts_text_secondary"
                                android:textSize="15sp" />

                            <EditText
                                android:id="@+id/etExerciseDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_input"
                                android:gravity="top"
                                android:hint="Description / notes (optional)"
                                android:inputType="textMultiLine|textCapSentences"
                                android:minLines="3"
                                android:padding="12dp"
                                android:textColor="@color/ts_text"
                                android:textColorHint="@color/ts_text_secondary"
                                android:textSize="15sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <EditText
                                    android:id="@+id/etSets"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_input"
                                    android:gravity="center"
                                    android:hint="Sets"
                                    android:inputType="number"
                                    android:padding="12dp"
                                    android:textColor="@color/ts_text"
                                    android:textColorHint="@color/ts_text_secondary"
                                    android:textSize="15sp" />

                                <EditText
                                    android:id="@+id/etReps"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_input"
                                    android:gravity="center"
                                    android:hint="Reps"
                                    android:inputType="number"
                                    android:padding="12dp"
                                    android:textColor="@color/ts_text"
                                    android:textColorHint="@color/ts_text_secondary"
                                    android:textSize="15sp" />

                                <EditText
                                    android:id="@+id/etWeight"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_input"
                                    android:gravity="center"
                                    android:hint="Kg"
                                    android:inputType="numberDecimal"
                                    android:padding="12dp"
                                    android:textColor="@color/ts_text"
                                    android:textColorHint="@color/ts_text_secondary"
                                    android:textSize="15sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/btnCancelExercise"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_button_outline"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:foreground="?attr/selectableItemBackground"
                                    android:gravity="center"
                                    android:paddingTop="12dp"
                                    android:paddingBottom="12dp"
                                    android:text="Cancel"
                                    android:textColor="@color/ts_text_secondary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/btnSaveExercise"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_button_primary"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:foreground="?attr/selectableItemBackground"
                                    android:gravity="center"
                                    android:paddingTop="12dp"
                                    android:paddingBottom="12dp"
                                    android:text="Save"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- STATE: DAY WITH NO EXERCISES -->
                        <LinearLayout
                            android:id="@+id/llEmptyNoExercises"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="48dp"
                            android:paddingBottom="48dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="This day is empty"
                                android:textColor="@color/ts_text"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="Tap the + button in the bottom right corner to add your first exercise."
                                android:textColor="@color/ts_text_secondary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Exercise cards (item_exercise) are added here from code -->
                        <LinearLayout
                            android:id="@+id/llExercisesContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </ScrollView>
            </FrameLayout>
        </LinearLayout>

        <!-- ADD EXERCISE BUTTON (visible after a day is selected) -->
        <TextView
            android:id="@+id/fabAddExercise"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:background="@drawable/bg_fab"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <!-- ================= SIDE MENU (DRAWER) ================= -->
    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/ts_surface"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <!-- Drawer header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ts_primary"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Training Sheet"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Menu"
                android:textColor="#BDBDBD"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Menu item: BMI Calculator -->
        <TextView
            android:id="@+id/menuBmi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp"
            android:text="BMI Calculator"
            android:textColor="@color/ts_text"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ts_divider" />

        <!-- Menu item: Training Analysis -->
        <TextView
            android:id="@+id/menuAnalysis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp"
            android:text="Training Analysis"
            android:textColor="@color/ts_text"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ts_divider" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>